{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "extensions/oracle/worker/run-job.mjs",
    "extensions/oracle/worker/auth-bootstrap.mjs",
    "extensions/oracle/worker/managed-browser.mjs"
  ]
}
